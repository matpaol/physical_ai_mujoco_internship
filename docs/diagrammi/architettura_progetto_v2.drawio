          <mxGeometry x="70" y="160" width="620" height="35" as="geometry" />
        </mxCell>
        <mxCell id="r_pre" value="&lt;b&gt;Stato prima Sₜ&lt;/b&gt;&lt;br&gt;pose di riferimento e target dopo assestamento precedente" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEB;strokeColor=#C96862;strokeWidth=1.6;fontColor=#1F2937;fontSize=15;align=center;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
