            <mxPoint x="1380" y="1075" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p_12" value="9  osserva Sₜ₊₁" style="html=1;rounded=0;edgeStyle=none;strokeColor=#3B82F6;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
