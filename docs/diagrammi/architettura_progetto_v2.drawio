        </mxCell>
        <mxCell id="p_9" value="6d  effetto / sensori" style="html=1;rounded=0;edgeStyle=none;strokeColor=#64748B;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1380" y="895" as="sourcePoint" />
            <mxPoint x="1075" y="895" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p_10" value="7  fattibilità + ExecutionOutcome" style="html=1;rounded=0;edgeStyle=none;strokeColor=#D58A1F;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1075" y="950" as="sourcePoint" />
            <mxPoint x="160" y="950" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p_loop_note" value="Ripeti 6a–6d finché la skill termina. Fₜ,ₖ serve al controllo di ESEGUI: non è Oₜ₊₁ e non richiama DECIDI." style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=14;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1120" y="712" width="620" height="97" as="geometry" />
        </mxCell>
        <mxCell id="p_exec_note" value="Anche un tentativo fallito può muovere la pila; si prosegue sempre con l'assestamento." style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=14;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1120" y="914" width="620" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p_after_label" value="&lt;b&gt;D · Assesta, riosserva, poi valuta la transizione&lt;/b&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=14;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="1020" width="1050" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p_11" value="8  attendi assestamento" style="html=1;rounded=0;edgeStyle=none;strokeColor=#64748B;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
