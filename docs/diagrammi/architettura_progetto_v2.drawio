        <mxCell id="r_e1" value="prima" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r_pre" target="r_task">
          <mxGeometry relative="1" as="geometry" />
