            <mxPoint x="770" y="485" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p_4" value="4  ObjectDecision(object_id)" style="html=1;rounded=0;edgeStyle=none;strokeColor=#4B9C54;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="770" y="540" as="sourcePoint" />
            <mxPoint x="160" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p_choice_note" value="* DecisionContext è previsto, non implementato. Il teacher può ricevere anche Pₜ in simulazione." style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=14;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1120" y="470" width="650" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p_exec_label" value="&lt;b&gt;C · Tentativo di ESEGUI: ciclo interno futuro, 0…N feedback&lt;/b&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=14;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="630" width="980" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p_5" value="5  esegui ObjectDecision" style="html=1;rounded=0;edgeStyle=none;strokeColor=#D58A1F;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="685" as="sourcePoint" />
            <mxPoint x="1075" y="685" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p_6" value="6a  richiedi Fₜ,ₖ" style="html=1;rounded=0;edgeStyle=none;strokeColor=#3B82F6;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1075" y="745" as="sourcePoint" />
            <mxPoint x="465" y="745" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p_7" value="6b  feedback sensoriale Fₜ,ₖ" style="html=1;rounded=0;edgeStyle=none;strokeColor=#3B82F6;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="465" y="795" as="sourcePoint" />
            <mxPoint x="1075" y="795" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p_8" value="6c  comando skill" style="html=1;rounded=0;edgeStyle=none;strokeColor=#D58A1F;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
