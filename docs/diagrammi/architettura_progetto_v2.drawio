            <mxPoint x="160" y="1185" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p_14" value="11  prima/dopo + scelta + fattibilità + esito" style="html=1;rounded=0;edgeStyle=none;strokeColor=#C5A424;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="1240" as="sourcePoint" />
            <mxPoint x="1685" y="1240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p_15" value="12  TaskOutcome(reward, terminated, metriche)" style="html=1;rounded=0;edgeStyle=none;strokeColor=#C5A424;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1685" y="1295" as="sourcePoint" />
            <mxPoint x="160" y="1295" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p_end_text" value="&lt;b&gt;13 · Se continua:&lt;/b&gt; Oₜ₊₁ diventa Oₜ del passo successivo; si aggiorna il contesto e si torna a DECIDI. &lt;b&gt;Solo training:&lt;/b&gt; la transizione va al trainer. &lt;b&gt;Fine:&lt;/b&gt; TASK produce terminated; il limite dei passi può produrre truncated nel wrapper ENVIRONMENT." style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=15;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="1380" width="1710" height="95" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="reward_v2" name="3 Dati per la reward">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1710" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="r_title" value="&lt;b&gt;Dati per la reward: chi li produce e quando&lt;/b&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=24;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1600" height="45" as="geometry" />
        </mxCell>
        <mxCell id="r_sub" value="TASK giudica una transizione completa. La nuova Observation serve a DECIDI; in simulazione la misura del disturbo usa lo stato vero." style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=15;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="75" width="1600" height="50" as="geometry" />
