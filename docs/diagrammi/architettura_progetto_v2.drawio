        <mxCell id="p_13" value="10  Oₜ₊₁ + Pₜ₊₁ (solo sim.)" style="html=1;rounded=0;edgeStyle=none;strokeColor=#3B82F6;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
