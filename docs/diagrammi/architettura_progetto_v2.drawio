        <mxCell id="p_before_note" value="Pₜ = PrivilegedStateₜ. ENVIRONMENT conserva i dati necessari per il confronto finale; lo student vede solo Oₜ." style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=14;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1120" y="270" width="650" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p_choice_label" value="&lt;b&gt;B · Una sola decisione&lt;/b&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=14;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="430" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p_3" value="3  Oₜ + contesto decisionale*" style="html=1;rounded=0;edgeStyle=none;strokeColor=#4B9C54;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
