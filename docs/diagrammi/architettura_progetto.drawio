                <mxCell id="c59" value="ESEGUI restituisce fatti: executable, attempted, removed, failure_reason, collision, durata, costo/energia. Non giudica se DECIDI avrebbe potuto scegliere un oggetto migliore." style="shape=partialRectangle;right=0;top=1;bottom=1;left=1;fillColor=none;html=1;whiteSpace=wrap;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="3800.0" y="960.0" width="430.0" height="55.0" as="geometry"/>
                </mxCell>
                <mxCell id="c60" value="DECIDI termina con ObjectDecision(object_id): non sceglie skill o traiettorie. La maschera esclude solo slot vuoti e oggetti rimossi, mai la fattibilità." style="shape=partialRectangle;right=0;top=1;bottom=1;left=1;fillColor=none;html=1;whiteSpace=wrap;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="2530.0" y="470.0" width="520.0" height="100.0" as="geometry"/>
                </mxCell>
                <mxCell id="c61" value="TASK contiene tutte le funzioni di reward. Usa lo stato prima e dopo (in simulazione quello vero, da PrivilegedState), ObjectDecision, FeasibilityAssessment ed ExecutionOutcome. Formula non ancora congelata." style="shape=partialRectangle;right=0;top=1;bottom=1;left=1;fillColor=none;html=1;whiteSpace=wrap;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="2360.0" y="1580.0" width="650.0" height="70.0" as="geometry"/>
                </mxCell>
                <mxCell id="c62" value="Observation e PrivilegedState sono contratti separati. PrivilegedState esiste soltanto in simulazione." style="shape=partialRectangle;right=0;top=1;bottom=1;left=1;fillColor=none;html=1;whiteSpace=wrap;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="625.0" y="20.0" width="430.0" height="90.0" as="geometry"/>
                </mxCell>
                <mxCell id="c63" value="Trainer/Evaluation giudica la qualità strategica: successo, numero di decisioni/rimozioni, tentativi falliti, scelte non eseguibili, disturbo e crolli. ESEGUI non suggerisce l’oggetto migliore." style="shape=partialRectangle;right=0;top=1;bottom=1;left=1;fillColor=none;html=1;whiteSpace=wrap;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1">
