    <diagram id="m6contrattidati" name="7 Contratti dati">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1880" pageHeight="500" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c1" value="&lt;b&gt;Contratti dati: cosa contiene ogni oggetto che passa fra i moduli&lt;/b&gt;   (bordo pieno = esiste nel codice, tratteggiato = previsto)" style="text;html=1;whiteSpace=wrap;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="40" y="0" width="1800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="&lt;b&gt;Observation&lt;/b&gt;&lt;br&gt;&lt;i&gt;OSSERVA → DECIDI&lt;/i&gt;&lt;br&gt;• scene: oggetti presenti con id, posa, forma, dimensioni, tipo, ruolo (target / ostacolo)&lt;br&gt;• relations: archi source → target (source sostiene target), relation_score&lt;br&gt;• uncertainty: visibilità e qualità (oracolo: tutto 1,0)&lt;br&gt;• gli oggetti rimossi spariscono: N cambia a ogni passo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#3B82F6;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="60" width="420" height="154" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="&lt;b&gt;PrivilegedState&lt;/b&gt;&lt;br&gt;&lt;i&gt;OSSERVA-oracolo → teacher, TASK, valutazione&lt;/i&gt;&lt;br&gt;• pose esatte e velocità&lt;br&gt;• massa, tre attriti, centro di massa&lt;br&gt;• forma e dimensioni&lt;br&gt;• anche gli oggetti rimossi (present = false)&lt;br&gt;• contact_supports: supporti dai contatti" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECEB;strokeColor=#C96862;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
                    <mxGeometry x="40" y="254" width="420" height="138" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="&lt;b&gt;DecisionContext&lt;/b&gt;&lt;br&gt;&lt;i&gt;Environment → DECIDI (dentro DecisionInput)&lt;/i&gt;&lt;br&gt;• per oggetto: tentativi, non eseguibili, falliti&lt;br&gt;• ultima azione scelta&lt;br&gt;• step_index (niente remaining_steps)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#64748B;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="500" y="60" width="420" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="c5" value="&lt;b&gt;DecisionInput&lt;/b&gt;&lt;br&gt;&lt;i&gt;Environment → DECIDI&lt;/i&gt;&lt;br&gt;• observation: Observation&lt;br&gt;• context: DecisionContext&lt;br&gt;• fase 2: + RobotState" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#64748B;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="500" y="206" width="420" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="c6" value="&lt;b&gt;ObjectDecision&lt;/b&gt;&lt;br&gt;&lt;i&gt;DECIDI → ESEGUI&lt;/i&gt;&lt;br&gt;• object_id: un solo oggetto per passo, target compreso" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F7E8;strokeColor=#4B9C54;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
                    <mxGeometry x="500" y="352" width="420" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="c7" value="&lt;b&gt;FeasibilityAssessment&lt;/b&gt;&lt;br&gt;&lt;i&gt;ESEGUI → Environment, TASK (prima del tentativo)&lt;/i&gt;&lt;br&gt;• executable&lt;br&gt;• failure_reason&lt;br&gt;• skill disponibile" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#D58A1F;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="960" y="60" width="420" height="106" as="geometry"/>
                </mxCell>
                <mxCell id="c8" value="&lt;b&gt;ExecutionOutcome&lt;/b&gt;&lt;br&gt;&lt;i&gt;ESEGUI → Environment, TASK (dopo il tentativo)&lt;/i&gt;&lt;br&gt;• oggi: object_id, removed, failure_reason&lt;br&gt;• previsti: attempted, collision, durata, costo" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#D58A1F;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
                    <mxGeometry x="960" y="206" width="420" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c9" value="&lt;b&gt;TaskOutcome&lt;/b&gt;&lt;br&gt;&lt;i&gt;TASK → Environment&lt;/i&gt;&lt;br&gt;• reward, terminated&lt;br&gt;• disturbance, collapsed, collapsed_ever&lt;br&gt;• target_removed, target_just_removed&lt;br&gt;• scene_is_empty, is_success" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8CE;strokeColor=#C5A424;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
                    <mxGeometry x="960" y="336" width="420" height="122" as="geometry"/>
                </mxCell>
                <mxCell id="c10" value="&lt;b&gt;Transition&lt;/b&gt;&lt;br&gt;&lt;i&gt;Environment → Trainer (solo training)&lt;/i&gt;&lt;br&gt;• DecisionInput, azione, reward, terminated / truncated&lt;br&gt;• scelta del teacher (per l&#39;imitazione)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#9167BB;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="1420" y="60" width="420" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="c11" value="&lt;b&gt;EpisodeMetrics&lt;/b&gt;&lt;br&gt;&lt;i&gt;Environment → Evaluation&lt;/i&gt;&lt;br&gt;• successo&lt;br&gt;• decisioni, rimozioni&lt;br&gt;• tentativi falliti, scelte non eseguibili&lt;br&gt;• disturbo totale, crolli" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#9167BB;fontSize=11;align=left;verticalAlign=top;spacing=6;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="1420" y="190" width="420" height="122" as="geometry"/>
                </mxCell>
                <mxCell id="c12" value="" style="html=1;rounded=0;edgeStyle=none;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=1;exitX=1.0000;exitY=0.2597;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3774;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c5">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="480" y="100"/>
                            <mxPoint x="480" y="246"/>
                        </Array>
