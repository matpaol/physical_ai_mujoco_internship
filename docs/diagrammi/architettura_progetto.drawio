    <diagram id="reward_v2" name="3 Dati per la reward">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1710" pageHeight="1040" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="r_title" value="&lt;b&gt;Dati per la reward: chi li produce e quando&lt;/b&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=24;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="50" y="25" width="1600" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="r_sub" value="TASK giudica una transizione completa. La nuova Observation serve a DECIDI; in simulazione la misura del disturbo usa lo stato vero." style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=15;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="50" y="75" width="1600" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="r_inputs" value="&lt;b&gt;Input disponibili al termine del passo&lt;/b&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=17;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="70" y="160" width="620" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="r_pre" value="&lt;b&gt;Stato prima Sₜ&lt;/b&gt;&lt;br&gt;pose di riferimento ricordate da TASK (reference_positions), salvate a reset o al passo precedente" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEB;strokeColor=#C96862;strokeWidth=1.6;fontColor=#1F2937;fontSize=15;align=center;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="75" y="225" width="340" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="r_decision" value="&lt;b&gt;ObjectDecision&lt;/b&gt;&lt;br&gt;object_id richiesto da DECIDI" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E8F7E8;strokeColor=#4B9C54;strokeWidth=1.6;fontColor=#1F2937;fontSize=15;align=center;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="75" y="370" width="340" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="r_exec" value="&lt;b&gt;Fatti di ESEGUI&lt;/b&gt;&lt;br&gt;oggi: ExecutionOutcome (removed, failure_reason); previsti: FeasibilityAssessment, collisione, tempo, costo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF0DB;strokeColor=#D58A1F;strokeWidth=1.6;fontColor=#1F2937;fontSize=15;align=center;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="75" y="515" width="340" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="r_post" value="&lt;b&gt;Stato dopo Sₜ₊₁&lt;/b&gt;&lt;br&gt;pose reali dopo il tentativo e l&#39;assestamento" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDECEB;strokeColor=#C96862;strokeWidth=1.6;fontColor=#1F2937;fontSize=15;align=center;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="75" y="680" width="340" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="r_task" value="&lt;b&gt;TASK · reward di DECIDI&lt;/b&gt;  (TargetExtractionTask)&lt;br&gt;&lt;br&gt;1. disturbo = massimo spostamento degli oggetti NON target fra Sₜ e Sₜ₊₁ (m)&lt;br&gt;2. crollo = disturbo &gt; 0,05 m&lt;br&gt;3. target estratto = il target non è più fra i presenti&lt;br&gt;4. reward = −0,05 per rimozione − 4 × disturbo + 1 se target estratto − 1 se crollo&lt;br&gt;5. terminated = target estratto o scena vuota" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8CE;strokeColor=#C5A424;strokeWidth=1.6;fontColor=#1F2937;fontSize=17;align=center;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="580" y="350" width="445" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="r_e1" value="prima" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r_pre" target="r_task">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r_e2" value="scelta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r_decision" target="r_task">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r_e3" value="fatti" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r_exec" target="r_task">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r_e4" value="dopo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r_post" target="r_task">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r_outcome" value="&lt;b&gt;TaskOutcome&lt;/b&gt;&lt;br&gt;reward · terminated · disturbo · crollo · successo" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8CE;strokeColor=#C5A424;strokeWidth=1.6;fontColor=#1F2937;fontSize=16;align=center;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="1195" y="350" width="430" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="r_training" value="&lt;b&gt;Trainer (solo training)&lt;/b&gt;&lt;br&gt;registra Oₜ, azione, reward, Oₜ₊₁ e aggiorna la policy" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#9167BB;strokeWidth=1.6;fontColor=#1F2937;fontSize=16;align=center;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="1195" y="570" width="430" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="r_e5" value="valutazione" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r_task" target="r_outcome">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r_e6" value="transizione" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="r_outcome" target="r_training">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r_future" value="&lt;b&gt;Reward delle skill di ESEGUI · futura classe separata in TASK&lt;/b&gt;&lt;br&gt;Il training delle skill userà i propri stati, feedback e costi nel suo ciclo di addestramento. Non si mescola alla reward strategica di DECIDI; sul robot non serve calcolarla." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2EAFE;strokeColor=#9167BB;strokeWidth=1.6;fontColor=#1F2937;fontSize=15;align=center;verticalAlign=middle;spacing=10;dashed=1;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="580" y="785" width="1045" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="r_note" value="&lt;b&gt;Nota sul codice attuale&lt;/b&gt; (valori in configs/phase_0b/env.json): azione su un oggetto già rimosso = −0,05 senza misura; truncated a 64 passi lo aggiunge il wrapper TimeLimit di Gymnasium, non TASK. Fattibilità, collisione, durata e costo sono previsti, non implementati." style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#1F2937;fontSize=14;align=left;verticalAlign=middle;spacing=10;dashed=0;fontStyle=0;" vertex="1" parent="1">
                    <mxGeometry x="70" y="950" width="1560" height="55" as="geometry"/>
